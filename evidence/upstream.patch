 ANCHOR_WEIGHTS = torch.tensor([5.0, 4.0, 3.0, 2.0, 1.0])
 
 
+def _linear_patch_embedding(self, hidden_states):
+    """Equivalent single-patch Conv3d projection, without tiny-convolution overhead.
+
+    Each input is exactly one kernel-sized patch; stride equals kernel size.
+    Opt-in runtime adaptation for this reproduction's Torch 2.9 / L40S setup.
+    """
+    weight = self.proj.weight
+    patches = hidden_states.reshape(-1, weight[0].numel()).to(
+        device=weight.device, dtype=weight.dtype
+    )
+    return torch.nn.functional.linear(patches, weight.flatten(1), self.proj.bias)
+
+
+def _chunked_vision_forward(self, hidden_states, grid_thw, **kwargs):
+    """Batch independent temporal patch groups without changing sampled frames.
+
+    Qwen3's vision attention uses a separate cu_seqlens interval per temporal
+    group. Positional embeddings repeat across those groups. Language attention
+    still sees every resulting video token together.
+    """
+    chunk_t = int(os.environ.get("HARNESSEVAL_VISION_CHUNK_T", "4"))
+    outputs, stacks, offset = [], [], 0
+    for t, h, w in grid_thw.tolist():
+        for start in range(0, t, chunk_t):
+            count = min(chunk_t, t - start)
+            n = count * h * w
+            grid = grid_thw.new_tensor([[count, h, w]])
+            output, stack = self._harnesseval_original_forward(
+                hidden_states[offset:offset+n], grid, **kwargs
+            )
+            outputs.append(output)
+            stacks.append(stack)
+            offset += n
+    return torch.cat(outputs), [torch.cat([s[i] for s in stacks]) for i in range(len(stacks[0]))]
+
+
 class PhysicalPlausibilityEvaluator:
     """Local PAVRM inference using Qwen3-VL reward model (transformers backend)."""
 
