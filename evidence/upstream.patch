+            for module in self.model.modules():
+                if type(module).__name__ == "Qwen3VLMoeVisionPatchEmbed":
+                    module.forward = types.MethodType(_linear_patch_embedding, module)
+        if int(os.environ.get("HARNESSEVAL_VISION_CHUNK_T", "0")) > 0:
+            for module in self.model.modules():
+                if type(module).__name__ == "Qwen3VLMoeVisionModel":
+                    module._harnesseval_original_forward = module.forward
+                    module.forward = types.MethodType(_chunked_vision_forward, module)
+        if os.environ.get("HARNESSEVAL_SPARSE_EXPERTS") == "1":
+            for module in self.model.modules():
+                if type(module).__name__ == "Qwen3VLMoeTextExperts":
+                    # This module has no dropout. Its training branch computes
